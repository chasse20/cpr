#!/usr/bin/env bash
# CPR client: Bash, curl, jq, OpenSSH; rsync for checkout.
set -euo pipefail
umask 077

fail() { printf 'cpr: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "Missing required command: $1"; }
usage() {
  cat <<'HELP'
Usage: cpr COMMAND

  help              List commands
  status            List active PRs and unfinished file cleanup
  show ID [--comment]
                    Show review history, or preview the prepared PR comment
  workers           List workers and their assignments
  pause WORKER_ID   Stop new assignments to a worker; current work continues
  resume WORKER_ID  Make a paused worker available again
  add URL           Add one GitHub pull request
  remove ID         Stop tracking; preserve saved work and database history
  purge ID          Stop tracking and delete all PR files, including edits
  cancel ID         Stop a review; preserve edits and release its worker
  review ID [--resolution TEXT]
                    Rereview, optionally recording a maintainer decision
  retry ID          Repair a saved final report without rerunning review or tests
  checkout ID       Copy the saved PR checkout locally
  connect ID        Open a manual session; summarize and save on exit
  approve ID        Integrate the latest target if needed, then publish

ID is the CPR ID shown by status. WORKER_ID is shown by workers.
Configuration: ~/.config/cpr/config
HELP
}

command_name=${1:-help}
if (($#)); then shift; fi
case "$command_name" in
  help)
    (($# == 0)) || fail 'Usage: cpr help'
    usage
    exit 0 ;;
  status|workers)
    (($# == 0)) || fail "Usage: cpr $command_name" ;;
  add)
    (($# == 1)) || fail 'Usage: cpr add URL (one PR at a time)' ;;
  review)
    (($# == 1 || $# == 3)) || fail 'Usage: cpr review ID [--resolution TEXT]'
    if (($# == 3)); then [[ $2 == --resolution ]] || fail 'Usage: cpr review ID [--resolution TEXT]'; fi ;;
  show)
    (($# == 1 || $# == 2)) || fail 'Usage: cpr show ID [--comment]'
    if (($# == 2)); then [[ $2 == --comment ]] || fail 'Usage: cpr show ID [--comment]'; fi ;;
  connect|checkout|approve|remove|cancel|purge|retry)
    (($# == 1)) || fail "Usage: cpr $command_name ID" ;;
  pause|resume)
    (($# == 1)) || fail "Usage: cpr $command_name WORKER_ID" ;;
  *) fail "Unknown command: $command_name. Run cpr help." ;;
esac

config_file=$HOME/.config/cpr/config
[[ -f $config_file ]] || fail "Missing $config_file. Copy client/config there and edit it."
declare -A settings=()
line_number=0
while IFS= read -r line || [[ -n $line ]]; do
  ((line_number += 1))
  line=${line%$'\r'}
  [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
  [[ $line =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]] || fail "$config_file:$line_number: expected KEY=value"
  key=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}
  case "$key" in
    CPR_API_URL|CPR_CHECKOUT_DIR|CPR_HTTP_TIMEOUT) settings[$key]=$value ;;
    *) fail "$config_file:$line_number: unknown setting $key" ;;
  esac
done < "$config_file"
for key in CPR_API_URL CPR_CHECKOUT_DIR CPR_HTTP_TIMEOUT; do
  [[ -n ${settings[$key]:-} ]] || fail "Set $key in $config_file"
done
[[ ${settings[CPR_API_URL]} =~ ^https?://[^[:space:]]+$ && ${settings[CPR_API_URL]} != *'?'* && ${settings[CPR_API_URL]} != *'#'* ]] || fail 'CPR_API_URL must be an http:// or https:// base URL'
[[ ${settings[CPR_HTTP_TIMEOUT]} =~ ^[1-9][0-9]{0,3}$ ]] && ((settings[CPR_HTTP_TIMEOUT] <= 3600)) || fail 'CPR_HTTP_TIMEOUT must be 1 to 3600 seconds'
case "${settings[CPR_CHECKOUT_DIR]}" in
  '~/'*) settings[CPR_CHECKOUT_DIR]="$HOME/${settings[CPR_CHECKOUT_DIR]:2}" ;;
esac
[[ ${settings[CPR_CHECKOUT_DIR]} == /* ]] || fail 'CPR_CHECKOUT_DIR must be an absolute path or start with ~/'

request() {
  local method=$1 path=$2 data=${3:-} timeout=${4:-${settings[CPR_HTTP_TIMEOUT]}} response code body
  need curl; need jq
  local -a args=(--disable --silent --show-error --connect-timeout 10
    --max-time "$timeout" --request "$method"
    --proto '=http,https' --header 'Accept: application/json'
    --header 'Content-Type: application/json' --write-out $'\n%{http_code}')
  if [[ -n $data ]]; then args+=(--data-raw "$data"); fi
  if ! response=$(curl "${args[@]}" "${settings[CPR_API_URL]%/}$path"); then
    fail "Cannot reach ${settings[CPR_API_URL]}. Check ~/.config/cpr/config and the SSH connection to the server."
  fi
  code=${response##*$'\n'}; body=${response%$'\n'*}
  if [[ ! $code =~ ^2[0-9][0-9]$ ]]; then
    [[ -z $body ]] || printf '%s\n' "${body:0:1500}" >&2
    fail "HTTP $code from $path"
  fi
  [[ -n $body ]] || body='null'
  jq -e 'true' <<< "$body" >/dev/null || fail "Invalid JSON response from $path"
  printf '%s\n' "$body"
}

print_table() {
  jq -r '
    def pad($n): . + (" " * ($n - length));
    (.[0] | length) as $columns |
    [range($columns) as $i | [.[][$i] | tostring | length] | max] as $widths |
    .[] | [range($columns) as $i | .[$i] | tostring | pad($widths[$i])] | join("  ")'
}
valid_id() { [[ $1 =~ ^[1-9][0-9]*$ ]] || fail 'ID must be a positive CPR ID'; }
worker_host() {
  local host worker_id
  host=$(jq -r '.sshHost // empty' <<< "$1")
  [[ -n $host ]] || fail 'This PR has no assigned worker yet.'
  worker_id=$(jq -r '.workerId // .workspaceWorkerId // empty' <<< "$1")
  [[ $worker_id =~ ^[1-9][0-9]*$ && $host == "cpr-$worker_id" ]] || fail "Unexpected worker SSH alias: $host"
  printf '%s' "$host"
}

case "$command_name" in
  status|workers)
    endpoint=/api/status
    [[ $command_name != workers ]] || endpoint=/api/worker
    result=$(request GET "$endpoint")
    if [[ $command_name == status ]]; then
      jq '[ ["ID", "PR", "Repository", "Target", "Status", "Cleanup"], (.[] | [.id, .number, .repository, .targetBranch, .status, (if .cleanedAt != null then "Done" elif .cleanupRequestedAt != null then "Pending" elif .status == "Removed" then "Saved" else "-" end)]) ]' <<< "$result" | print_table
      jq -r '.[] | select(.lastError != null and .lastError != "") | "\nPR \(.id): \(.lastError)"' <<< "$result"
    else
      jq '[ ["Worker", "SSH host", "Status", "CPR ID"], (.[] | [.id, .sshHost, .status, (.pullRequestId // "-")]) ]' <<< "$result" | print_table
    fi ;;
  pause|resume)
    [[ $1 =~ ^[1-9][0-9]{0,9}$ ]] && (( $1 <= 2147483647 )) || fail 'WORKER_ID must be a positive worker ID from cpr workers'
    need jq
    worker_status=Paused
    [[ $command_name != resume ]] || worker_status=Online
    payload=$(jq -cn --arg status "$worker_status" '{status: $status}')
    result=$(request PUT "/api/worker/$1/status" "$payload")
    jq -r '"Worker \(.id): \(.status)"' <<< "$result" ;;
  add)
    url=$1
    [[ $url =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*/?$ ]] || fail "Invalid GitHub PR URL: $url"
    need jq
    payload=$(jq -cn --arg url "$url" '{url: $url}')
    result=$(request POST /api/pr "$payload")
    jq -r '"\(.id)  PR #\(.number)  \(.repository) -> \(.targetBranch)  \(.status)"' <<< "$result" ;;
  show)
    valid_id "$1"
    result=$(request GET "/api/pr/$1")
    if [[ ${2:-} == --comment ]]; then
      jq -e '.prComment | type == "string" and test("\\S")' <<< "$result" >/dev/null || fail "No prepared PR comment. Use cpr retry $1 for a failed final report, or cpr review $1 to reassess code."
      jq -r '.prComment' <<< "$result"
      exit 0
    fi
    jq -r '
      def usage_summary:
        if .usage.input_tokens == null or .usage.cached_input_tokens == null or .usage.output_tokens == null then "tokens unknown"
        else "tokens " + (if .usage.is_complete == true then "" else "at least " end) +
          "input=\(.usage.input_tokens), cached=\(.usage.cached_input_tokens), output=\(.usage.output_tokens)" end;
      "PR #\(.number)  \(.repository)  CPR \(.id)  \(.status)",
      "Target: \(.targetBranch)  Head: \(.remoteSha)",
      (if .preparedSha != null then "Prepared tree: \(.preparedSha)  Reviewed target: \(.reviewedTargetSha)" else empty end),
      "Next: \(.nextAction)",
      (if .recovery.category != null then "Recovery: \(.recovery.category); \(.recovery.attempts) automatic retries used\(if .recovery.nextAttemptAt != null then "; next check " + .recovery.nextAttemptAt else "" end)" else empty end),
      (if .prComment != null then "PR comment preview: cpr show \(.id) --comment" else empty end),
      (if .lastError != null then "Reason: \(.lastError)" else empty end),
      (if .codeRabbit != null then
        "CodeRabbit: \(if .isCodeRabbitEnabled == false then "disabled" elif .codeRabbit.isInitialized then "watching" else "initializing" end); \(.codeRabbit.pending | length) comments pending",
        (if .codeRabbit.lastAttemptAt != null then "  Last repair: \(.codeRabbit.lastAttemptAt); \(.codeRabbit.lastBatch | length) comments" else empty end),
        (if .codeRabbit.lastError != null then "  Feedback: \(.codeRabbit.lastError)" else empty end)
       else empty end),
      (if .maintainerResolution != null then "Maintainer resolution: \(.maintainerResolution)" else empty end),
      (if .cleanupRequestedAt != null then "Files: \(if .cleanedAt != null then "deleted" else "cleanup pending on workers " + (.storageWorkerIds | map(tostring) | join(", ")) end)" else empty end),
      . as $pr |
      (.runs[]? |
        (if .publishedSha != null then
          "\nPR comment for \(.publishedSha): " +
          (if .commentId != null then "https://github.com/\($pr.repository)/pull/\($pr.number)#issuecomment-\(.commentId)"
           elif .commentError != null then "delivery failed; retry pending — " + .commentError
           else "delivery pending" end)
         else empty end),
        (.details |
        "\nRun \(.key): \(.manifest.status // "unknown")\(if .manifest.kind == "manual_tweak" then " (manual tweaks; no automated review)" elif .manifest.kind == "report_retry" then " (report recovery; saved review reused)" elif .manifest.kind == "merge_repair" then " (focused merge repair)" elif .manifest.kind == "feedback_repair" or .manifest.review_scope == "feedback_repair" then " (CodeRabbit repair)" else "" end)",
        (if .manifest.is_historical == true then "  Historical report: retained original snapshot; subsequent changes need their own integration checks" else empty end),
        (if .manifest.maintainer_resolution != null then "  Maintainer resolution: \(.manifest.maintainer_resolution)" else empty end),
        (.attempts[]? | "  \(.step // "unknown") attempt \(.attempt // "?"): \(.model // "?") / \(.reasoning_effort // "?")  \(.status // "unknown"); \(usage_summary)",
          (.report_normalization? // empty | "    Report repair: " + .),
          (.report_recovery? | select(. != null) | "    Automatic recovery: \(.model) / \(.reasoning_effort)  \(.status); \(usage_summary)",
            (.diagnosis? | select(. != null) | "      Reason [\(.category)]: \(.summary)", "      Next: \(.next_action)")),
          (.saved_validation? | select(. != null) | "    Saved-evidence validation: \(.model) / \(.reasoning_effort)  \(.status); \(usage_summary)"),
          (.report_repairs[]? | "    Report writing: \(.model) / \(.reasoning_effort)  \(.status); \(usage_summary)"),
          (.result // {} | (.summary // .capture_error // empty | "    Result: " + .),
            (.findings[]? | "    Finding [\(.severity)] \(.location): \(.impact)"))),
        (.manifest.feedback_dispositions[]? | "CodeRabbit [\(.status)] \(.key): \(.reason)"),
        (.result // {} | .summary // empty,
          (if (.commit_message // "") != "" then "Proposed commit:\n" + .commit_message else empty end),
          ((.coverage // {}) | to_entries[] | "Coverage [\(.key)]: \(.value.status) — \(.value.details)"),
          (if (.scope_audit // "") != "" then "Scope audit: \(.scope_audit)" else empty end),
          (if .relevance != null then "Relevance: \(.relevance.status) — \(.relevance.details)" else empty end),
          (.findings[]? | "Finding [\(.severity)] \(.location): \(.impact)\n  Repair: \(.repair)"),
          (.checks[]? | "Check [\(.status)\(if .superseded_by != null then "; superseded by " + .superseded_by else "" end)] \(.command)\n  \(.details)"),
          (.limitations[]? | "Limitation: \(.)"),
          (if .follow_up != null and .follow_up != "" then "Follow-up: \(.follow_up)" else empty end),
          .capture_error // empty),
        (if .changes != "" then .changes else empty end)))' <<< "$result" ;;
  review)
    valid_id "$1"; need jq
    payload=''
    if (($# == 3)); then
      current=$(request GET "/api/pr/$1")
      jq -e 'has("maintainerResolution")' <<< "$current" >/dev/null || fail 'Server does not support maintainer resolutions; update the CPR schema and orchestrator first.'
      payload=$(jq -cn --arg resolution "$3" '{resolution: $resolution}')
    fi
    result=$(request POST "/api/pr/$1/review" "$payload")
    jq -r '.message' <<< "$result" ;;
  approve|remove|cancel|purge|retry)
    valid_id "$1"
    if [[ $command_name == remove ]]; then
      result=$(request DELETE "/api/pr/$1")
    else
      result=$(request POST "/api/pr/$1/$command_name")
    fi
    jq -r '.message' <<< "$result" ;;
  connect)
    id=$1; valid_id "$id"; need ssh
    printf 'Preparing the saved workspace for manual recovery...\n'
    result=$(request POST "/api/pr/$id/connect" '' 600)
    jq -e '.isTweak == true' <<< "$result" >/dev/null || fail 'Update the CPR orchestrator: connect requires manual completion.'
    if [[ -z $(jq -r '.sshHost // empty' <<< "$result") ]]; then
      printf 'PR %s: no worker assigned yet. Run cpr connect %s once a worker is ready.\n' "$id" "$id"
      exit 0
    fi
    host=$(worker_host "$result")
    session=$(jq -r '.sessionId // empty' <<< "$result")
    [[ $session =~ ^[A-Za-z0-9_-]{6,128}$ ]] || session=''
    target=$(jq -r '.targetBranch' <<< "$result")
    codex_args=(codex --sandbox danger-full-access)
    [[ -z $session ]] || codex_args+=(resume "$session")
    codex_args+=("This is a maintainer-requested manual CPR session for CPR $id, target branch $target. Wait for my instructions and change only what I request. Before editing, read applicable repository AGENTS.md, CODE_GUIDE.md, CODE_STYLE.md, and linked style requirements; apply the current target's rules within the requested scope. Preserve all saved review repairs and maintainer decisions. Local Git staging and commits are authorized to finish a pending merge and integrate the latest target; do not rewrite saved history. Run only relevant checks. Do not repeat the full CPR review or push, publish, or merge the GitHub PR. Record checks actually run and their results in /state/cpr/jobs/$id/tweak-checks.md. On successful exit CPR summarizes only this session and saves its snapshot; publication requires cpr approve $id.")
    printf 'Opening manual Codex session for PR %s on %s...\n' "$id" "$host"
    printf -v codex_command '%q ' "${codex_args[@]}"
    remote_script="test \"\$(cat /state/cpr/active-id)\" = \"$id\" && test ! -f /state/cpr/released-$id && cd /workspace/repo && exec $codex_command"
    printf -v remote_command 'flock -n --close /state/cpr/worker.lock bash -c %q' "$remote_script"
    if ! ssh -t -o StrictHostKeyChecking=yes "$host" "$remote_command"; then
      fail 'Codex session did not exit successfully; edits remain on the worker.'
    fi
    printf 'Summarizing this session and saving the snapshot...\n'
    result=$(request POST "/api/pr/$id/complete" '' 0)
    jq -r '"PR \(.id): \(.status); snapshot \(.preparedSha)"' <<< "$result"
    if [[ $(jq -r '.status' <<< "$result") == ReadyForApproval ]]; then
      printf 'Saved locally. Inspect with cpr show %s; publish with cpr approve %s.\n' "$id" "$id"
    else
      printf 'Saved locally. CPR will resume the missing initial review work and affected validation. Follow with cpr show %s.\n' "$id"
    fi ;;
  checkout)
    valid_id "$1"; need ssh; need rsync
    result=$(request GET "/api/pr/$1/connection")
    host=$(worker_host "$result")
    project_directory=$(jq -r '.projectDirectory // empty' <<< "$result")
    [[ $project_directory == "/workspace/jobs/$1/repo" ]] || fail 'Unexpected PR checkout path from CPR'
    mkdir -p -- "${settings[CPR_CHECKOUT_DIR]}"
    destination=$(mktemp -d "${settings[CPR_CHECKOUT_DIR]}/pr-$1-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")
    if ! rsync -a --safe-links --no-specials --no-devices --no-owner --no-group --protect-args \
      -e 'ssh -o BatchMode=yes -o StrictHostKeyChecking=yes' "$host:$project_directory/" "$destination/"; then
      fail "Checkout failed; partial copy retained at $destination. The worker needs rsync installed."
    fi
    printf 'Local checkout: %s\n' "$destination" ;;
  *) fail "Unknown command: $command_name. Run cpr help." ;;
esac
